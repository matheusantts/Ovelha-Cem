# Ovelha Cem — configuração do servidor (Hostinger / LiteSpeed / Apache)

# ---------------------------------------------------------------
# Redirecionamento único: http e www -> https://ovelhacem.com.br
# (um só salto, para não encadear http -> https -> sem www)
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://ovelhacem.com.br%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.ovelhacem\.com\.br$ [NC]
  RewriteRule ^ https://ovelhacem.com.br%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------------------------------------------------------------
# Compressão (gzip e brotli, quando o servidor oferece)
# ---------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml application/rss+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript text/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml application/xml
</IfModule>

# ---------------------------------------------------------------
# Cache do navegador
# - CSS e JS: o build coloca ?v=<hash> na URL, então podem ficar 1 ano em cache.
# - Imagens e fontes: 1 ano. Ao trocar uma imagem, use um NOME NOVO para o arquivo.
# - HTML: sempre revalida, para o visitante receber as novas versões na hora.
# ---------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|avif|jpg|jpeg|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
